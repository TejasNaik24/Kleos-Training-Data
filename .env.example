# ---------------------------------------------------------------------------
# KLEOS Training Data — environment template
#
# Copy to .env for local use. .env is git-ignored and must NEVER be committed.
#
#     cp .env.example .env
#
# Every variable below is OPTIONAL. The entire offline pipeline — scenario
# generation, mock capture, sanitization, review, promotion, release and
# verification — runs with none of them set. That is deliberate: the pipeline
# that produces a dataset must be exercisable, and testable, without a single
# credential.
#
# Check your configuration without printing any value:
#
#     python scripts/doctor.py
# ---------------------------------------------------------------------------

# --- Backend capture (only for --adapter kleos_chat / kleos_json) -----------
#
# Leave KLEOS_BACKEND_URL pointing at a local development backend. Capturing
# against production is gated behind four independent conditions — see
# src/kleos_training_data/collection/guard.py — and produces data that can
# never be promoted (see PRIVACY.md, "Capture lanes").
KLEOS_BACKEND_URL=http://127.0.0.1:8000
KLEOS_API_TOKEN=
KLEOS_TIMEOUT_SECONDS=60
KLEOS_MAX_RETRIES=3
KLEOS_REQUESTS_PER_MINUTE=20
KLEOS_MAX_CONCURRENCY=2

# Must be exactly "1", together with --allow-production, the confirmation
# phrase, and a non-CI environment, before any production capture runs.
# Unset unless you are deliberately doing that today.
KLEOS_ALLOW_PRODUCTION_CAPTURE=

# --- Workspace --------------------------------------------------------------
KLEOS_TRAINING_DATA_ENV=development
KLEOS_STAGING_DIR=staging
KLEOS_VAULT_DIR=vault
KLEOS_RELEASES_DIR=releases
KLEOS_REPORTS_DIR=reports

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Note that no level ever logs conversation
# content — see src/kleos_training_data/logging_utils.py.
KLEOS_DATA_LOG_LEVEL=INFO

# --- AI-assisted review (only for --reviewer anthropic) ---------------------
# CI always uses the deterministic MockReviewer and needs no key.
ANTHROPIC_API_KEY=

# --- kleos-models compatibility --------------------------------------------
#
# Path to a local checkout of the PUBLIC repo, used only by
# `python scripts/check_contract_compat.py` and the differential tests. When
# unset, those tests skip and the compat check reports SKIPPED unless --strict.
#
# The commit the contract mirror is pinned to is recorded in code, not here:
# src/kleos_training_data/contract/pin.py
KLEOS_MODELS_PATH=
